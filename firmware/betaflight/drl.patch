--- /dev/null
+++ b/src/main/io/drl_led.c
@@ -0,0 +1,144 @@
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "platform.h"
+
+#ifdef USE_DRL_LED_BRIDGE
+
+#include "fc/rc_modes.h"
+#include "common/time.h"
+#include "flight/failsafe.h"
+#include "rx/rx.h"
+#include "io/drl_led.h"
+#include "io/drl_led_rpc.h"
+#include "msp/msp_serial.h"
+#include "pg/pg.h"
+#include "pg/pg_ids.h"
+
+PG_REGISTER_WITH_RESET_TEMPLATE(drlLedConfig_t, drlLedConfig, PG_DRL_LED_CONFIG, 0);
+
+PG_RESET_TEMPLATE(drlLedConfig_t, drlLedConfig, .map = {3, 3, 3}, .color = {69, 69, 69},
+                  .gif = {33, 33, 33}, .state = {7, 7, 7});
+
+static uint8_t lastMask;
+static bool primed;
+static int8_t pendingPreset = -1;
+static uint8_t pendingStep;
+static bool pendingAdvance;
+static bool drlLedSend(const uint8_t *message, unsigned length)
+{
+    const int status = drlRpcResult(message, length);
+    if (status < 0) {
+        pendingPreset = -1;
+        pendingAdvance = false;
+    }
+    return status > 0;
+}
+
+static bool drlLedPushSetting(const char *name, uint8_t value)
+{
+    uint8_t message[40] = {DRL_LED_SETTING, 's', 'e', 't', ' '};
+    unsigned length = 5;
+    while (*name && length < sizeof(message) - 5)
+        message[length++] = *name++;
+    message[length++] = ' ';
+    if (value >= 100)
+        message[length++] = '0' + value / 100;
+    if (value >= 10)
+        message[length++] = '0' + value / 10 % 10;
+    message[length++] = '0' + value % 10;
+    return drlLedSend(message, length);
+}
+
+bool drlLedApplyPreset(unsigned index)
+{
+    if (index >= DRL_LED_PRESET_COUNT)
+        return false;
+    pendingPreset = (int8_t)index;
+    pendingStep = 0;
+    pendingAdvance = false;
+    return true;
+}
+
+void drlLedPoll(void)
+{
+
+    if (!rxIsReceivingSignal() || !rxAreFlightChannelsValid() || failsafeIsActive()) {
+        drlRpcCancel();
+        pendingPreset = -1;
+        pendingAdvance = false;
+        pendingStep = 0;
+        primed = false;
+        lastMask = 0;
+        return;
+    }
+
+    uint8_t mask = 0;
+    if (IS_RC_MODE_ACTIVE(BOXUSER1))
+        mask |= 1;
+    if (IS_RC_MODE_ACTIVE(BOXUSER2))
+        mask |= 2;
+    if (IS_RC_MODE_ACTIVE(BOXUSER3))
+        mask |= 4;
+    if (IS_RC_MODE_ACTIVE(BOXUSER4))
+        mask |= 8;
+
+    // Restore selection switches when the receiver connects. A held Advance switch needs a new edge.
+    const uint8_t rising = primed ? mask & ~lastMask : mask & 0x0e;
+    primed = true;
+    lastMask = mask;
+    drlRpcPoll();
+    if (rising & 2)
+        drlLedApplyPreset(0);
+    else if (rising & 4)
+        drlLedApplyPreset(1);
+    else if (rising & 8)
+        drlLedApplyPreset(2);
+    else if (rising & 1)
+        pendingAdvance = true;
+
+    if (pendingPreset >= 0) {
+        const unsigned index = (unsigned)pendingPreset;
+        const drlLedConfig_t *config = drlLedConfig();
+        if (pendingStep == 0) {
+            const uint8_t map = config->map[index];
+            if (map < 1 || map > 5) {
+                pendingPreset = -1;
+                return;
+            }
+            const uint8_t data[] = {DRL_LED_MAP, map};
+            if (drlLedSend(data, sizeof(data))) {
+                pendingStep = 1;
+            }
+        } else if (pendingStep == 1) {
+            if (config->state[index] == 1 || config->state[index] == 6) {
+                const uint8_t asset[] = {137, config->state[index] == 1 ? 1 : 2,
+                                         config->gif[index]};
+                if (drlLedSend(asset, sizeof(asset)))
+                    pendingPreset = -1;
+                return;
+            }
+            const uint8_t data[] = {DRL_LED_COLOR, config->color[index]};
+            if (drlLedSend(data, sizeof(data)))
+                pendingStep = 2;
+        } else if (pendingStep == 2) {
+            if (config->gif[index] <= 32) {
+                if (drlLedPushSetting("gif_animation_index", config->gif[index]))
+                    pendingStep = 3;
+            } else
+                pendingStep = 3;
+        } else {
+            if (config->state[index] >= 1 && config->state[index] <= 5) {
+                if (drlLedPushSetting("animation_state", config->state[index]))
+                    pendingPreset = -1;
+            } else
+                pendingPreset = -1;
+        }
+    } else if (pendingAdvance) {
+        const uint8_t data[] = {DRL_LED_ADVANCE};
+        if (drlLedSend(data, sizeof(data)))
+            pendingAdvance = false;
+    }
+}
+
+#endif
