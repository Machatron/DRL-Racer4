+            drlLedConfig_t *c = drlLedConfigMutable();
+            c->map[q[0]] = q[1];
+            c->color[q[0]] = q[2];
+            c->gif[q[0]] = q[3];
+            c->state[q[0]] = q[4];
+            sbufWriteU8(dst, 0);
+        } else
+            return MSP_RESULT_ERROR;
+        reply->result = MSP_RESULT_ACK;
+        return MSP_RESULT_ACK;
+    }
