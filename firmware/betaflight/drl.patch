diff --git a/src/main/io/drl_led_protocol.h b/src/main/io/drl_led_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..ab750d289c0f946ae2a1d981e28bd715a3e268d7
--- /dev/null
+++ b/src/main/io/drl_led_protocol.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <stdint.h>
+
+#define DRL_RPC 136
+#define DRL_RPC_VERSION 2
+#define DRL_RPC_REPLY_SIZE 13
+#define DRL_RPC_MAX 64
+
+#define DRL_RPC_DRIVER_WAIT_MS 2000u
+#define DRL_RPC_REPLY_WAIT_MS 2300u
+#define DRL_RPC_TOTAL_WAIT_MS 8000u
+
+#define DRL_FILE_PUBLISH_WAIT_MS 45000u
+#define DRL_FILE_PUBLISH_REPLY_WAIT_MS 46000u
+enum {
+    DRL_OK,
+    DRL_BAD_REQUEST,
+    DRL_CONFLICT,
+    DRL_VERIFY_FAILED,
+    DRL_UNSUPPORTED,
+    DRL_BUSY = 8,
+    DRL_TIMEOUT = 9
+};
+
+static inline int drlAdvanceTarget(const uint8_t *r, uint8_t *expected, uint8_t *target)
+{
+    if (r[10] != 1)
+        return 0;
+    if (r[6] == 2 && r[7] <= 69) {
+        *expected = r[7];
+        *target = r[7] == 69 ? 3 : r[7] + 1;
+        return 1;
+    }
+    if (r[6] == 1 && r[9] && r[8] < r[9] && r[9] <= 32) {
+        *expected = r[8];
+        *target = r[8] + 1 < r[9] ? r[8] + 1 : 0;
+        return 1;
+    }
+    return 0;
+}
diff --git a/src/main/io/drl_led_rpc.c b/src/main/io/drl_led_rpc.c
new file mode 100644
index 0000000000000000000000000000000000000000..a5bf12fed8361ba30580a63a6681aa7a13fd68e9
--- /dev/null
+++ b/src/main/io/drl_led_rpc.c
@@ -0,0 +1,186 @@
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include "io/drl_led_rpc.h"
+#include "common/time.h"
+#include "drivers/time.h"
+#include "msp/msp_serial.h"
+
+static uint16_t sequence;
+static uint8_t request[64], original[60];
+static unsigned requestSize, originalSize, attempts;
+static uint32_t sentAt, beganAt;
+static bool active, waiting, advanceQuery;
+static int result;
+
+static unsigned wrap(uint8_t *out, const uint8_t *command, unsigned size)
+{
+    if (!size || size > 60)
+        return 0;
+    ++sequence;
+    out[0] = DRL_RPC;
+    out[1] = DRL_RPC_VERSION;
+    out[2] = sequence;
+    out[3] = sequence >> 8;
+    memcpy(out + 4, command, size);
+    return size + 4;
+}
+
+static bool matches(const uint8_t *r, unsigned n, const uint8_t *q)
+{
+    return n == DRL_RPC_REPLY_SIZE && !memcmp(r, q, 5);
+}
+
+static int exchange(uint8_t *q, unsigned n, uint8_t *r)
+{
+    // Keep the same sequence on retries so a lost reply cannot advance twice.
+    for (unsigned i = 0; i < 3; i++) {
+        attempts = i + 1;
+        int got = mspRemoteOsdExchange(q, n, r, DRL_RPC_REPLY_SIZE);
+        if (got > 0 && matches(r, (unsigned)got, q)) {
+            if (r[5] != DRL_BUSY && r[5] != DRL_TIMEOUT)
+                return r[5];
+        }
+        if (i < 2)
+            delay(53 + 17 * i);
+    }
+    return DRL_TIMEOUT;
+}
+
+int drlRpcExchange(const uint8_t *command, unsigned size, uint8_t *reply)
+{
+    if (active)
+        return DRL_BUSY;
+    uint8_t q[64];
+    unsigned n;
+    if (size == 1 && command[0] == 132) {
+        const uint8_t query = 133;
+        n = wrap(q, &query, 1);
+        int status = exchange(q, n, reply);
+        if (status)
+            return status;
+        uint8_t next[4] = {132, reply[6], 0, 0};
+        if (!drlAdvanceTarget(reply, &next[2], &next[3]))
+            return DRL_CONFLICT;
+        n = wrap(q, next, sizeof(next));
+    } else
+        n = wrap(q, command, size);
+    if (!n)
+        return DRL_BAD_REQUEST;
+    return exchange(q, n, reply);
+}
+
+bool drlRpcStart(const uint8_t *command, unsigned size)
+{
+    if (active || !size || size > sizeof(original))
+        return false;
+    memcpy(original, command, size);
+    originalSize = size;
+    advanceQuery = size == 1 && command[0] == 132;
+    const uint8_t query = 133;
+    requestSize = wrap(request, advanceQuery ? &query : command, advanceQuery ? 1 : size);
+    active = true;
+    waiting = false;
+    attempts = 0;
+    result = 0;
+    beganAt = millis();
+    sentAt = beganAt - 100;
+    return true;
+}
+
+void drlRpcPoll(void)
+{
+    if (!active)
+        return;
+    uint32_t now = millis();
+
+    if ((uint32_t)(now - beganAt) >= DRL_RPC_TOTAL_WAIT_MS) {
+        mspRemoteLedResume();
+        active = false;
+        result = -DRL_TIMEOUT;
+        return;
+    }
+    if (waiting) {
+        if ((uint32_t)(now - sentAt) < DRL_RPC_REPLY_WAIT_MS)
+            return;
+        mspRemoteLedResume();
+        waiting = false;
+    }
+    if (attempts >= 3) {
+        active = false;
+        result = -DRL_TIMEOUT;
+        return;
+    }
+    if ((uint32_t)(now - sentAt) < (unsigned)(53 + 17 * attempts))
+        return;
+    if (!mspRemoteLedPush(request, requestSize))
+        return;
+    sentAt = now;
+    waiting = true;
+    ++attempts;
+}
+
+void drlRpcReply(const uint8_t *reply, unsigned size)
+{
+    if (!active || !matches(reply, size, request))
+        return;
+    mspRemoteLedResume();
+    if (reply[5] == DRL_BUSY || reply[5] == DRL_TIMEOUT) {
+        waiting = false;
+        sentAt = millis();
+        return;
+    }
+    if (reply[5]) {
+        active = false;
+        result = -(int)reply[5];
+        return;
+    }
+    if (advanceQuery) {
+        uint8_t next[4] = {132, reply[6], 0, 0};
+        if (!drlAdvanceTarget(reply, &next[2], &next[3])) {
+            active = false;
+            result = -DRL_CONFLICT;
+            return;
+        }
+        requestSize = wrap(request, next, sizeof(next));
+        advanceQuery = false;
+        waiting = false;
+        attempts = 0;
+        beganAt = millis();
+        sentAt = beganAt - 100;
+    } else {
+        active = false;
+        result = 1;
+    }
+}
+
+int drlRpcResult(const uint8_t *command, unsigned size)
+{
+    if (active)
+        return 0;
+    if (!result) {
+        drlRpcStart(command, size);
+        return 0;
+    }
+    int value = result;
+    result = 0;
+
+    if (size != originalSize || memcmp(command, original, size)) {
+        drlRpcStart(command, size);
+        return 0;
+    }
+    return value;
+}
+
+unsigned drlRpcAttempts(void)
+{
+    return attempts;
+}
+void drlRpcCancel(void)
+{
+    if (active)
+        mspRemoteLedResume();
+    active = false;
+    waiting = false;
+    result = 0;
+}
