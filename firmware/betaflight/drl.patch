diff --git a/src/main/io/drl_vtx.c b/src/main/io/drl_vtx.c
new file mode 100644
index 0000000000000000000000000000000000000000..5f03b980ad00619f4b9d6df9df46d43ee2cbb68c
--- /dev/null
+++ b/src/main/io/drl_vtx.c
@@ -0,0 +1,70 @@
+#include <stdbool.h>
+#include <stdint.h>
+#include "platform.h"
+#include "common/time.h"
+#include "common/streambuf.h"
+#include "drivers/vtx_common.h"
+#include "fc/runtime_config.h"
+#include "io/vtx.h"
+#include "io/vtx_string.h"
+#include "io/vtx_smartaudio.h"
+#include "io/drl_vtx.h"
+
+int drlVtxCommand(sbuf_t *src, sbuf_t *dst)
+{
+    const int n = sbufBytesRemaining(src);
+    if (n != 1 && n != 6)
+        return -1;
+    const uint8_t op = sbufReadU8(src);
+    vtxDevice_t *device = vtxCommonDevice();
+    const uint8_t type = vtxCommonGetDeviceType(device);
+    const bool ready = type == VTXDEV_SMARTAUDIO && saResponseIsFresh();
+    if (op == 1 && n == 6) {
+        const uint8_t band = sbufReadU8(src), channel = sbufReadU8(src);
+        const uint8_t power = sbufReadU8(src), pit = sbufReadU8(src), low = sbufReadU8(src);
+        if (ARMING_FLAG(ARMED) || !ready || band < 1 || band > 5 || channel < 1 || channel > 8 ||
+            power < 1 || power > saPowerCount || pit > 1 || low > 1 ||
+            (pit && saDevice.version < 3))
+            return -1;
+        vtxSettingsConfigMutable()->band = band;
+        vtxSettingsConfigMutable()->channel = channel;
+        vtxSettingsConfigMutable()->freq = vtx58_Bandchan2Freq(band, channel);
+        vtxSettingsConfigMutable()->power = power;
+        vtxSettingsConfigMutable()->lowPowerDisarm = low;
+        uint8_t currentPit = 0;
+        vtxCommonGetPitMode(device, &currentPit);
+        if (currentPit != pit)
+            vtxCommonSetPitMode(device, pit);
+    } else if (op != 0 || n != 1)
+        return -1;
+
+    uint8_t band = 0, channel = 0, power = 0, pit = 0;
+    uint16_t frequency = 0;
+    if (ready) {
+        vtxCommonGetBandAndChannel(device, &band, &channel);
+        vtxCommonGetPowerIndex(device, &power);
+        vtxCommonGetPitMode(device, &pit);
+        vtxCommonGetFrequency(device, &frequency);
+    }
+    sbufWriteU8(dst, 1);
+    sbufWriteU8(dst, type);
+    sbufWriteU8(dst, type == VTXDEV_SMARTAUDIO ? saDevice.version : 0);
+    sbufWriteU8(dst, ready);
+    sbufWriteU8(dst, vtxSettingsConfig()->band);
+    sbufWriteU8(dst, vtxSettingsConfig()->channel);
+    sbufWriteU8(dst, vtxSettingsConfig()->power);
+    sbufWriteU8(dst, vtxSettingsConfig()->lowPowerDisarm);
+    sbufWriteU8(dst, band);
+    sbufWriteU8(dst, channel);
+    sbufWriteU8(dst, power);
+    sbufWriteU8(dst, pit);
+    sbufWriteU16(dst, vtxSettingsConfig()->freq);
+    sbufWriteU16(dst, frequency);
+    sbufWriteU8(dst, ready ? saPowerCount : 0);
+    for (unsigned i = 0; i < VTX_SMARTAUDIO_POWER_COUNT; ++i)
+        sbufWriteU8(dst, ready && saDevice.version == 3 && i < saPowerCount ? saPowerDbm[i] : 0);
+    sbufWriteU16(dst, saStat.pktsent);
+    sbufWriteU16(dst, saStat.pktrcvd);
+    sbufWriteU16(dst, saStat.crc);
+    return 1;
+}
