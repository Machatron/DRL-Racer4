+            sbufReadData(src, q + 1, n);
+            int got = mspRemoteOsdExchange(q, n + 1, r, sizeof(r));
+            if (got < 1 || r[0] != DRL_LED_FILE)
+                sbufWriteU8(dst, DRL_TIMEOUT);
+            else if (got == 2)
+                sbufWriteU8(dst, r[1]);
+            else {
+                sbufWriteU8(dst, 0);
+                sbufWriteData(dst, r + 1, got - 1);
+            }
+        } else if (op == 3 && n == 0) {
+            const drlLedConfig_t *c = drlLedConfig();
+            for (unsigned i = 0; i < 3; i++) {
+                sbufWriteU8(dst, c->map[i]);
+                sbufWriteU8(dst, c->color[i]);
+                sbufWriteU8(dst, c->gif[i]);
+                sbufWriteU8(dst, c->state[i]);
+            }
+        } else if (op == 4 && n == 5) {
+            sbufReadData(src, q, 5);
+            if (q[0] > 2 || q[1] < 1 || q[1] > 5 || q[2] > 69 || q[3] > 33 || q[4] < 1 ||
+                q[4] > 7 || ((q[4] == 1 || q[4] == 6) && q[3] > 31))
