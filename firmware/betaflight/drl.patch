+#ifdef USE_REMOTE_MAX7456
+static uint32_t remoteOsdMaintenanceUntil;
+bool mspRemoteOsdMaintenanceActive(void)
+{
+    return (int32_t)(remoteOsdMaintenanceUntil - millis()) > 0;
+}
+
+int mspRemoteOsdExchange(uint8_t *data, unsigned length, uint8_t *response, unsigned capacity)
+{
+    mspPort_t *remote = NULL;
+    for (unsigned i = 0; i < MAX_MSP_PORT_COUNT; ++i) {
+        if (mspPorts[i].port && mspPorts[i].port->identifier == SERIAL_PORT_USART6) {
+            remote = &mspPorts[i];
+            break;
+        }
+    }
+    if (!remote || !length || length > 64)
+        return -1;
+
+    const uint32_t replyTimeoutMs =
+        data[0] == 135   ? (length > 4 && data[4] == 3 ? DRL_FILE_PUBLISH_REPLY_WAIT_MS : 2000)
+        : data[0] == 136 ? DRL_RPC_REPLY_WAIT_MS
+                         : 300;
+    remoteOsdMaintenanceUntil = millis() + replyTimeoutMs + 200;
+
+    const uint32_t drainStarted = millis();
+    while (!isSerialTransmitBufferEmpty(remote->port)) {
+        if ((uint32_t)(millis() - drainStarted) >= 100)
+            return -1;
+    }
+
+    while (serialRxBytesWaiting(remote->port))
+        serialRead(remote->port);
+    remote->c_state = MSP_IDLE;
+    if (serialTxBytesFree(remote->port) < length + 6)
+        return -1;
+    mspPacket_t packet = {
+        .buf = {.ptr = data, .end = data + length}, .cmd = 182, .direction = MSP_DIRECTION_REPLY};
+    if (mspSerialEncode(remote, &packet, MSP_V1) != (int)length + 6)
+        return -1;
+    const uint32_t started = millis();
+    while ((uint32_t)(millis() - started) < replyTimeoutMs) {
+        if (!serialRxBytesWaiting(remote->port))
+            continue;
+        const uint8_t received = serialRead(remote->port);
+        mspSerialProcessReceivedData(remote, received);
+        if (remote->c_state != MSP_COMMAND_RECEIVED)
+            continue;
+        remote->c_state = MSP_IDLE;
+        if (remote->packetType != MSP_PACKET_REPLY || remote->cmdMSP != 182 || !remote->dataSize ||
+            remote->inBuf[0] != data[0])
+            continue;
+        if ((data[0] == 121 || data[0] == 122) &&
+            (remote->dataSize < 3 || remote->inBuf[2] != data[1]))
+            continue;
+
+        if (data[0] == 135 && remote->dataSize != 2 &&
+            (length < 6 || remote->dataSize < 17 || memcmp(remote->inBuf + 1, data + 1, 5)))
+            continue;
+        if (data[0] == 136 && (remote->dataSize != 13 || memcmp(remote->inBuf, data, 5)))
+            continue;
+        if (remote->dataSize > capacity)
+            return -1;
+        memcpy(response, remote->inBuf, remote->dataSize);
+        if (data[0] == 136)
+            remoteOsdMaintenanceUntil = 0;
+        return remote->dataSize;
+    }
+    remote->c_state = MSP_IDLE;
+    if (data[0] == 136)
+        remoteOsdMaintenanceUntil = 0;
+    return -1;
+}
+
+void mspRemoteLedResume(void)
+{
+    remoteOsdMaintenanceUntil = 0;
+}
+
+// AUX actions run in the flight scheduler. Queue the request without waiting for the EC.
+bool mspRemoteLedPush(const uint8_t *data, unsigned length)
+{
+    if (!data || !length || length > 64 || mspRemoteOsdMaintenanceActive())
+        return false;
+    for (unsigned i = 0; i < MAX_MSP_PORT_COUNT; ++i) {
+        mspPort_t *remote = &mspPorts[i];
+        if (!remote->port || remote->port->identifier != SERIAL_PORT_USART6)
+            continue;
+        if (serialTxBytesFree(remote->port) < length + 6)
+            return false;
+        mspPacket_t packet = {.buf = {.ptr = (uint8_t *)data, .end = (uint8_t *)data + length},
+                              .cmd = MSP_DISPLAYPORT,
+                              .direction = MSP_DIRECTION_REPLY};
+        if (mspSerialEncode(remote, &packet, MSP_V1) != (int)length + 6)
+            return false;
+
+        // Pause OSD traffic while the EC waits for the driver. The displayed pixels remain on the OSD chip.
+        remoteOsdMaintenanceUntil = millis() + DRL_RPC_REPLY_WAIT_MS;
+        return true;
+    }
+    return false;
+}
+#endif
 
