+            const int status = drlRpcExchange(q, n, r);
+            sbufWriteU8(dst, status);
+            if (status == DRL_OK)
+                sbufWriteData(dst, r, DRL_RPC_REPLY_SIZE);
+        } else if (op == 2 && n >= 13 && n <= 45) {
