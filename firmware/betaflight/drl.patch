+#ifdef USE_DRL_LED_BRIDGE
+static bool ecQuiet;
+static bool cliDrlLedExchange(uint8_t *command, unsigned size)
+{
+    uint8_t reply[DRL_RPC_REPLY_SIZE];
+    const int status = drlRpcExchange(command, size, reply);
+    if (status != DRL_OK) {
+        cliPrintLinef(
+            "EC not confirmed: %u (1 invalid, 2 state conflict, 3 verify, 8 busy, 9 timeout)",
+            status);
+        return false;
+    }
+    if (!ecQuiet)
+        cliPrintLinef("EC confirmed (attempts %u)", drlRpcAttempts());
+    return true;
+}
+
+static bool cliDrlLedNumber(const char *arg, int low, int high, int *value)
+{
+    if (!arg || !*arg)
+        return false;
+    char *end;
+    const long parsed = strtol(arg, &end, 10);
+    if (*end || parsed < low || parsed > high)
+        return false;
+    *value = (int)parsed;
+    return true;
+}
+
+static bool cliDrlLedSettingValue(const char *name, unsigned value)
+{
+    uint8_t command[48] = {DRL_LED_SETTING};
+    const int count = tfp_sprintf((char *)command + 1, "set %s %u", name, value);
+    if (count < 1 || count > 46)
+        return false;
+    return cliDrlLedExchange(command, (unsigned)count + 1);
+}
+
+static int cliDrlHexDigit(char c)
+{
+    if (c >= '0' && c <= '9')
+        return c - '0';
+    if (c >= 'a' && c <= 'f')
+        return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F')
+        return c - 'A' + 10;
+    return -1;
+}
+
+static void cliDrlLedFile(const char *hex)
+{
+    const unsigned length = strlen(hex);
+    if (length < 26 || length > 90 || (length & 1)) {
+        cliShowParseError();
+        return;
+    }
+    uint8_t request[46] = {DRL_LED_FILE}, reply[64];
+    for (unsigned i = 0; i < length / 2; ++i) {
+        const int hi = cliDrlHexDigit(hex[2 * i]), lo = cliDrlHexDigit(hex[2 * i + 1]);
+        if (hi < 0 || lo < 0) {
+            cliShowParseError();
+            return;
+        }
+        request[1 + i] = (hi << 4) | lo;
+    }
+    const int size = mspRemoteOsdExchange(request, 1 + length / 2, reply, sizeof(reply));
+    if (size < 0) {
+        cliPrintLine("ECFILE TIMEOUT");
+        return;
+    }
+    if (size == 2) {
+        cliPrintLinef("ECFILE TRANSPORT %u", reply[1]);
+        return;
+    }
+    cliPrint("ECFILE ");
+    for (int i = 1; i < size; ++i)
+        cliPrintf("%02x", reply[i]);
+    cliPrintLinefeed();
+}
+
+static void cliDrlLed(char *cmdline)
+{
+    if (ARMING_FLAG(ARMED)) {
+        cliPrintLine("Disarm before using EC controls");
+        return;
+    }
+    char *saveptr;
+    char *action = strtok_r(cmdline, " ", &saveptr);
+    if (action && (!strcmp(action, "set") || !strcmp(action, "effect"))) {
+        while (*saveptr == ' ')
+            ++saveptr;
+        const unsigned length = strlen(saveptr);
+        if (!length || length > 54) {
+            cliShowParseError();
+            return;
+        }
+        uint8_t command[64] = {DRL_LED_SETTING, 's', 'e', 't', ' '};
+        if (!strcmp(action, "effect")) {
+            const char prefix[] = "custom_color ";
+            if (length > 41) {
+                cliShowParseError();
+                return;
+            }
+            memcpy(command + 5, prefix, sizeof(prefix) - 1);
+            memcpy(command + 5 + sizeof(prefix) - 1, saveptr, length);
+            cliDrlLedExchange(command, length + 5 + sizeof(prefix) - 1);
+        } else {
+            memcpy(command + 5, saveptr, length);
+            cliDrlLedExchange(command, length + 5);
+        }
+        return;
+    }
+    char *arg = strtok_r(NULL, " ", &saveptr);
+    char *extra = strtok_r(NULL, " ", &saveptr);
+    if (!action || extra) {
+        cliShowParseError();
+        return;
+    }
+    if (!strcmp(action, "file") && arg) {
+        cliDrlLedFile(arg);
+        return;
+    }
+    if (!strcmp(action, "status") && !arg) {
+        uint8_t command[] = {DRL_LED_QUERY}, reply[DRL_RPC_REPLY_SIZE];
+        const int status = drlRpcExchange(command, sizeof(command), reply);
+        if (status == DRL_OK) {
+            cliPrintLinef("EC bridge v2, driver state %u, color %u, GIF %u, map %u", reply[6],
+                          reply[11], reply[8], reply[12]);
+        } else {
+            cliPrintLinef("EC driver not confirmed: %u", status);
+        }
+        return;
+    }
+    if (!strcmp(action, "advance") && !arg) {
+        uint8_t command[] = {DRL_LED_ADVANCE};
+        cliDrlLedExchange(command, sizeof(command));
+        return;
+    }
+    int value;
+    if ((!strcmp(action, "gif") || !strcmp(action, "load")) &&
+        cliDrlLedNumber(arg, 0, 31, &value)) {
+        uint8_t command[] = {137, !strcmp(action, "gif") ? 1 : 2, (uint8_t)value};
+        cliDrlLedExchange(command, sizeof(command));
+        return;
+    }
+    if (!strcmp(action, "state") && cliDrlLedNumber(arg, 1, 5, &value)) {
+        cliDrlLedSettingValue("animation_state", value);
+        return;
+    }
+
+    if (!strcmp(action, "color") && cliDrlLedNumber(arg, 0, 69, &value)) {
+        uint8_t command[] = {DRL_LED_COLOR, (uint8_t)value};
+        cliDrlLedExchange(command, sizeof(command));
+        return;
+    }
+    if (!strcmp(action, "map") && cliDrlLedNumber(arg, 1, 5, &value)) {
+        uint8_t command[] = {DRL_LED_MAP, (uint8_t)value};
+        cliDrlLedExchange(command, sizeof(command));
+        return;
+    }
+    if (!strcmp(action, "preset") && cliDrlLedNumber(arg, 1, DRL_LED_PRESET_COUNT, &value)) {
+        const unsigned index = (unsigned)(value - 1);
+        if (drlLedConfig()->state[index] == 0) {
+            cliPrintLine("EC preset state must be 1..7");
+            return;
+        }
+        uint8_t map[] = {DRL_LED_MAP, drlLedConfig()->map[index]};
+        uint8_t color[] = {DRL_LED_COLOR, drlLedConfig()->color[index]};
+        ecQuiet = true;
+        bool ok = cliDrlLedExchange(map, sizeof(map));
+        if (drlLedConfig()->state[index] == 1 || drlLedConfig()->state[index] == 6) {
+            uint8_t asset[] = {137, drlLedConfig()->state[index] == 1 ? 1 : 2,
+                               drlLedConfig()->gif[index]};
+            if (ok)
+                ok = cliDrlLedExchange(asset, sizeof(asset));
+        } else {
+            if (ok)
+                ok = cliDrlLedExchange(color, sizeof(color));
+            if (ok && drlLedConfig()->gif[index] <= 32)
+                ok = cliDrlLedSettingValue("gif_animation_index", drlLedConfig()->gif[index]);
+            if (ok && drlLedConfig()->state[index] >= 1 && drlLedConfig()->state[index] <= 5)
+                ok = cliDrlLedSettingValue("animation_state", drlLedConfig()->state[index]);
+        }
+        ecQuiet = false;
+        if (ok)
+            cliPrintLinef("EC preset %u confirmed", index + 1);
+        return;
+    }
+    cliShowParseError();
+}
+#endif
