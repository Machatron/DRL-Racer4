+'use strict';
+var EC_GIF = (function () {
+    function prepare(input) {
+        var bytes = new Uint8Array(input);
+        if (bytes.length > 8 * 1024 * 1024) throw new Error('GIF input exceeds 8 MB.');
+        var reader = new GifReader(bytes),
+            w = reader.width,
+            h = reader.height;
+        var count = reader.numFrames();
+        // Only this Racer3 file needs its seven arm rows expanded. Match its size and CRC.
+
+        var sevenRowArms =
+            w === 42 &&
+            h === 13 &&
+            bytes.length === 19042 &&
+            EC.crc32(Array.from(bytes)) === 0xd539d18b;
+        if (!count || count > 2000 || w * h > 1048576 || w * h * count > 64000000)
+            throw new Error(
+                'GIF is too large to convert. Use a smaller canvas or shorter animation.'
+            );
+
+        if (w === 42 && h === 13 && bytes.length <= 65535 && !sevenRowArms) {
+            EC.validateGif(Array.from(bytes));
+            return {
+                bytes: Array.from(bytes),
+                frames: count,
+                note:
+                    '42 x 13, ' +
+                    count +
+                    (count === 1 ? ' frame, ' : ' frames, ') +
+                    bytes.length +
+                    ' bytes'
+            };
+        }
+        var canvas = new Uint8Array(w * h * 4),
+            frames = [],
+            palette = [0],
+            colors = new Map([[0, 0]]);
+        var scale = Math.min(1, 42 / w, 13 / h),
+            dw = Math.max(1, Math.round(w * scale)),
+            dh = Math.max(1, Math.round(h * scale));
+        var left = Math.floor((42 - dw) / 2),
+            top = Math.floor((13 - dh) / 2);
+
+        var bg = [0, 0, 0, 255],
+            bi = 13 + bytes[11] * 3;
+        if (bytes[10] & 128 && bi + 2 < bytes.length)
+            bg = [bytes[bi], bytes[bi + 1], bytes[bi + 2], 255];
+        function clear(info) {
+            var fill = info.transparent_index !== null ? [0, 0, 0, 0] : bg;
+            for (var y = info.y; y < info.y + info.height; y++)
+                for (var x = info.x; x < info.x + info.width; x++)
+                    canvas.set(fill, (y * w + x) * 4);
+        }
+        var first = reader.frameInfo(0);
+        if (first.transparent_index === null)
+            for (var k = 0; k < canvas.length; k += 4) canvas.set(bg, k);
+        for (var f = 0; f < count; f++) {
+            var info = reader.frameInfo(f);
+            if (info.x + info.width > w || info.y + info.height > h || info.disposal > 3)
+                throw new Error('Unsupported GIF frame.');
+            var saved = info.disposal === 3 ? canvas.slice() : null;
+            reader.decodeAndBlitFrameRGBA(f, canvas);
+            var pixels = new Uint32Array(42 * 13);
+            for (var yy = 0; yy < dh; yy++)
+                for (var xx = 0; xx < dw; xx++) {
+                    var src =
+                        (Math.min(h - 1, Math.floor(((yy + 0.5) * h) / dh)) * w +
+                            Math.min(w - 1, Math.floor(((xx + 0.5) * w) / dw))) *
+                        4;
+                    var rgb = canvas[src + 3]
+                        ? (canvas[src] << 16) | (canvas[src + 1] << 8) | canvas[src + 2]
+                        : 0;
+                    pixels[(top + yy) * 42 + left + xx] = rgb;
+                    if (!colors.has(rgb)) {
+                        colors.set(rgb, palette.length);
+                        palette.push(rgb);
+                    }
+                }
+            if (sevenRowArms) {
+                for (var lane = 39; lane <= 40; lane++) {
+                    var original = [];
+                    for (var row = 6; row < 13; row++) original.push(pixels[row * 42 + lane]);
+                    for (var row = 0; row < 13; row++)
+                        pixels[row * 42 + lane] = original[Math.round((row * 6) / 12)];
+                }
+            }
+            frames.push({ pixels: pixels, delay: info.delay });
+            if (info.disposal === 2) clear(info);
+            if (saved) canvas = saved;
+        }
