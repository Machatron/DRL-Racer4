+                e.preventDefault();
+                if (running || !latest || !latest.ready) return;
+                var q = [
+                    1,
+                    Number($('#dv-band').val()),
+                    Number($('#dv-channel').val()),
+                    Number($('#dv-power').val()),
+                    $('#dv-pit').prop('checked') ? 1 : 0,
+                    $('#dv-low').prop('checked') ? 1 : 0
+                ];
+                if (
+                    q.slice(1).some(function (n) {
+                        return !Number.isInteger(n);
+                    }) ||
+                    !q[3]
+                )
+                    return;
+                running = true;
+                controls();
+                message('Saving…');
+                try {
+                    var saved = await DRL_VTX.request(q);
+                    if (
+                        saved.band !== q[1] ||
+                        saved.channel !== q[2] ||
+                        saved.power !== q[3] ||
+                        saved.low !== q[5]
+                    )
+                        throw new Error('FC settings did not match.');
