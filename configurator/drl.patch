+        function pad(p) {
+            while (p.length < 2 || p.length & (p.length - 1)) p.push(0);
+            return p;
+        }
+        var output = [],
+            writer = new GifWriter(output, 42, 13, {
+                palette: shared ? pad(palette) : [0, 0],
+                loop: reader.loopCount()
+            });
+        var previous = null;
+        frames.forEach(function (frame) {
+            var x0 = 0,
+                y0 = 0,
+                x1 = 41,
+                y1 = 12;
+            if (previous) {
+                x0 = 42;
+                y0 = 13;
+                x1 = -1;
+                y1 = -1;
+                for (var y = 0; y < 13; y++)
+                    for (var x = 0; x < 42; x++)
+                        if (frame.pixels[y * 42 + x] !== previous[y * 42 + x]) {
+                            x0 = Math.min(x0, x);
+                            x1 = Math.max(x1, x);
+                            y0 = Math.min(y0, y);
+                            y1 = Math.max(y1, y);
+                        }
+                if (x1 < 0) {
+                    x0 = y0 = x1 = y1 = 0;
+                }
+            }
+            var p = shared ? palette : [],
+                lookup = shared ? colors : new Map(),
+                indexed = [];
+            for (var py = y0; py <= y1; py++)
+                for (var px = x0; px <= x1; px++) {
+                    var c = frame.pixels[py * 42 + px];
+                    if (!lookup.has(c)) {
+                        lookup.set(c, p.length);
+                        p.push(c);
+                    }
+                    indexed.push(lookup.get(c));
+                }
+            if (p.length > 256)
+                throw new Error(
+                    'Converted frame needs more than 256 colors. Reduce its palette first.'
+                );
+            var opts = { delay: frame.delay, disposal: 1 };
+            if (!shared) opts.palette = pad(p);
+            writer.addFrame(x0, y0, x1 - x0 + 1, y1 - y0 + 1, indexed, opts);
+            previous = frame.pixels;
+        });
+        output.length = writer.end();
+        if (output.length > 65535)
+            throw new Error(
+                'GIF is ' +
+                    output.length +
+                    ' bytes after conversion; limit is 65535. Shorten the animation before uploading.'
+            );
+        EC.validateGif(output);
+        return {
+            bytes: output,
+            frames: count,
+            note:
+                w +
+                ' x ' +
+                h +
+                ' → 42 x 13, ' +
+                count +
+                (count === 1 ? ' frame, ' : ' frames, ') +
+                output.length +
+                ' bytes' +
+                (sevenRowArms
+                    ? ' (Racer3 arm lanes fitted)'
+                    : scale < 1
+                      ? ' (scaled to fit)'
+                      : ' (colors and timing preserved)')
+        };
+    }
+    return { prepare: prepare };
+})();
