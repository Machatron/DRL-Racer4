diff --git a/src/js/drl_vtx.js b/src/js/drl_vtx.js
new file mode 100644
index 0000000000000000000000000000000000000000..8005e0ce305962aa3e433b1e3384ee01409486da
--- /dev/null
+++ b/src/js/drl_vtx.js
@@ -0,0 +1,282 @@
+'use strict';
+
+var DRL_VTX = {
+    code: 0x3001,
+    busy: false,
+    generation: 0,
+    bands: ['User', 'A', 'B', 'E', 'Airwave', 'Race'],
+    frequencies: [
+        [5865, 5845, 5825, 5805, 5785, 5765, 5745, 5725],
+        [5733, 5752, 5771, 5790, 5809, 5828, 5847, 5866],
+        [5705, 5685, 5665, 5645, 5885, 5905, 5925, 5945],
+        [5740, 5760, 5780, 5800, 5820, 5840, 5860, 5880],
+        [5658, 5695, 5732, 5769, 5806, 5843, 5880, 5917]
+    ],
+    matches: function () {
+        return (
+            (CONFIG.boardIdentifier === 'R4S' ||
+                CONFIG.boardIdentifier === 'R4F4' ||
+                CONFIG.boardName === 'RACER4S' ||
+                CONFIG.boardName === 'RACER4F4') &&
+            semver.lt(CONFIG.apiVersion, '1.42.0')
+        );
+    },
+    parse: function (b) {
+        if (b.length !== 27 || b[0] !== 1 || b[16] > 4)
+            throw new Error('Matching FC firmware is required for VTX controls.');
+        return {
+            type: b[1],
+            version: b[2],
+            ready: !!b[3],
+            band: b[4],
+            channel: b[5],
+            power: b[6],
+            low: b[7],
+            actualBand: b[8],
+            actualChannel: b[9],
+            actualPower: b[10],
+            pit: b[11],
+            frequency: b[12] | (b[13] << 8),
+            actualFrequency: b[14] | (b[15] << 8),
+            count: b[16],
+            dbm: b.slice(17, 21),
+            sent: b[21] | (b[22] << 8),
+            received: b[23] | (b[24] << 8),
+            crc: b[25] | (b[26] << 8)
+        };
+    },
+    request: function (payload) {
+        if (this.busy) return Promise.reject(new Error('Wait for the current operation.'));
+        this.busy = true;
+        return new Promise(function (resolve, reject) {
+            var timer = setTimeout(function () {
+                MSP.callbacks = MSP.callbacks.filter(function (c) {
+                    if (c.code !== DRL_VTX.code) return true;
+                    clearInterval(c.timer);
+                    return false;
+                });
+                DRL_VTX.busy = false;
+                reject(new Error('VTX request timed out. Refresh before trying again.'));
+            }, 3000);
+
+            MSP.send_message(
+                DRL_VTX.code,
+                payload,
+                false,
+                function (reply) {
+                    clearTimeout(timer);
+                    DRL_VTX.busy = false;
+                    if (reply.crcError || !reply.length)
+                        return reject(
+                            new Error(
+                                'VTX request rejected. Check connection, firmware and disarmed state.'
+                            )
+                        );
+                    try {
+                        resolve(
+                            DRL_VTX.parse(
+                                Array.from(
+                                    new Uint8Array(
+                                        reply.data.buffer,
+                                        reply.data.byteOffset,
+                                        reply.data.byteLength
+                                    )
+                                )
+                            )
+                        );
+                    } catch (e) {
+                        reject(e);
+                    }
+                },
+                true
+            );
+        });
+    },
+    powerLabel: function (s, index) {
+        if (!index || index > s.count) return 'Unknown';
+        if (s.version !== 3 || !s.dbm[index - 1]) return 'Level ' + index;
+
+        var dbm = s.dbm[index - 1],
+            nominal = { 14: 25, 20: 100, 26: 400, 27: 500, 28: 600, 30: 1000 };
+        return (nominal[dbm] || Number(Math.pow(10, dbm / 10).toPrecision(2))) + ' mW';
+    },
+    initialize: function (callback) {
+        var generation = ++this.generation,
+            latest = null,
+            running = false;
+        GUI.active_tab = 'vtx';
+        $('#content').load('./tabs/drl_vtx.html', function () {
+            for (var band = 1; band <= 5; band++)
+                $('#dv-band').append(new Option(DRL_VTX.bands[band], band));
+            function channels(value) {
+                var band = Number($('#dv-band').val());
+                $('#dv-channel').empty();
+                DRL_VTX.frequencies[band - 1].forEach(function (freq, i) {
+                    $('#dv-channel').append(new Option(i + 1, i + 1));
+                });
+                $('#dv-channel').val(value || 1);
+                frequency();
+            }
+            function frequency() {
+                $('#dv-frequency').val(
+                    DRL_VTX.frequencies[Number($('#dv-band').val()) - 1][
+                        Number($('#dv-channel').val()) - 1
+                    ]
+                );
+            }
+            function message(text, error) {
+                $('#dv-message').text(text).toggleClass('error', !!error);
+            }
+            function controls() {
+                var disabled = running || !latest || !latest.ready;
+                $('#dv-save')
+                    .toggleClass('disabled', disabled)
+                    .attr('aria-disabled', String(disabled));
+                $('#dv-refresh')
+                    .toggleClass('disabled', running)
+                    .attr('aria-disabled', String(running));
+            }
+            function paint(s, fill) {
+                latest = s;
+                $('#dv-link').text(s.ready ? 'Connected' : 'No reply');
+                $('#dv-protocol').text(
+                    s.type === 3
+                        ? 'SmartAudio ' + ({ 1: '1.0', 2: '2.0', 3: '2.1' }[s.version] || '')
+                        : 'Not configured'
+                );
+                $('#dv-actual-band').text(s.ready ? DRL_VTX.bands[s.actualBand] : 'Unknown');
+                $('#dv-actual-channel').text(s.ready ? s.actualChannel : 'Unknown');
+                $('#dv-actual-frequency').text(s.ready ? s.actualFrequency + ' MHz' : 'Unknown');
+                $('#dv-actual-power').text(
+                    s.ready ? DRL_VTX.powerLabel(s, s.actualPower) : 'Unknown'
+                );
+                $('#dv-actual-pit').text(s.ready ? (s.pit ? 'On' : 'Off') : 'Unknown');
+                $('#dv-pit').prop('disabled', s.version < 3);
+                if (fill) {
+                    $('#dv-band').val(s.band || 4);
+                    channels(s.channel);
+                    $('#dv-power').empty();
+                    for (var i = 1; i <= s.count; i++)
+                        $('#dv-power').append(new Option(DRL_VTX.powerLabel(s, i), i));
+                    $('#dv-power').val(s.power);
+                    $('#dv-low').prop('checked', !!s.low);
+                    $('#dv-pit').prop('checked', !!s.pit);
+                }
+                controls();
+            }
+            async function refresh(fill) {
+                running = true;
+                controls();
+                try {
+                    var s = await DRL_VTX.request([0]);
+                    if (generation !== DRL_VTX.generation) return;
+                    paint(s, fill);
+                    message(
+                        s.ready
+                            ? ''
+                            : 'No SmartAudio reply. Check VTX power and the SA connection to ' +
+                              (CONFIG.boardIdentifier === 'R4F4' || CONFIG.boardName === 'RACER4F4' ? 'TX3.' : 'TX4.'),
+                        !s.ready
+                    );
+                } catch (e) {
+                    if (generation === DRL_VTX.generation) {
+                        latest = null;
+                        message(e.message, true);
+                    }
+                } finally {
+                    running = false;
+                    if (generation === DRL_VTX.generation) controls();
+                }
+            }
+            $('#dv-band').on('change', function () {
+                channels(Number($('#dv-channel').val()));
+            });
+            $('#dv-channel').on('change', frequency);
+            $('#dv-refresh').on('click', function (e) {
+                e.preventDefault();
+                if (!running) refresh(true);
+            });
