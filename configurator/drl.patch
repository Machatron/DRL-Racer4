+    async function saveSwitches() {
+        // Read fresh ranges so saving LED switches preserves changes made in Modes.
+        await msp(MSPCodes.MSP_MODE_RANGES);
+        var ranges = MODE_RANGES.map(function (r) {
+            return JSON.parse(JSON.stringify(r));
+        });
+        var rows = $('#ec-switch-rows tr').toArray(),
+            pending = [];
+        rows.forEach(function (el, i) {
+            var row = $(el),
+                aux = Number(row.find('.aux').val()),
+                start = Number(row.find('.start').val()),
+                end = Number(row.find('.end').val());
+            if (
+                aux >= 0 &&
+                (!Number.isInteger(aux) ||
+                    aux > 13 ||
+                    start < 900 ||
+                    end > 2100 ||
