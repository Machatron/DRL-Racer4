+                            );
+                        }, 3000);
+                        MSP.send_message(
+                            MSPCodes.MSP_EEPROM_WRITE,
+                            false,
+                            false,
+                            function (r) {
+                                clearTimeout(t);
+                                if (r.crcError || r.unsupported)
+                                    reject(new Error('Save rejected.'));
+                                else resolve();
+                            },
+                            true
+                        );
+                    });
+                    for (var i = 0; i < 10; i++) {
+                        await new Promise(function (resolve) {
+                            setTimeout(resolve, 500);
+                        });
+                        if (generation !== DRL_VTX.generation) return;
+                        var s = await DRL_VTX.request([0]);
+                        paint(s, false);
+
+                        if (
+                            s.ready &&
+                            s.actualBand === q[1] &&
+                            s.actualChannel === q[2] &&
+                            s.actualPower === (q[5] ? 1 : q[3]) &&
+                            s.pit === q[4]
+                        ) {
+                            message('Saved. VTX confirmed.');
+                            return;
+                        }
+                    }
+                    message('Saved on FC. VTX has not confirmed all settings yet.', true);
+                } catch (e) {
+                    if (generation === DRL_VTX.generation) message(e.message, true);
+                } finally {
+                    running = false;
+                    if (generation === DRL_VTX.generation) controls();
+                }
+            });
+            GUI.content_ready(callback);
+            refresh(true);
+        });
+    },
+    cleanup: function () {
+        ++this.generation;
+    }
+};
