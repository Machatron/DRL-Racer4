+'use strict';
+
+var EC = {
+    code: 0x3000,
+    busy: false,
+    sequence: 1,
+    request: function (payload) {
+        if (this.busy) return Promise.reject(new Error('Wait for the current operation.'));
+        this.busy = true;
+        return new Promise(function (resolve, reject) {
+            var timer = setTimeout(
+                function () {
+                    MSP.callbacks = MSP.callbacks.filter(function (c) {
+                        if (c.code !== EC.code) return true;
+                        clearInterval(c.timer);
+                        return false;
+                    });
+                    EC.busy = false;
+                    reject(
+                        new Error(
+                            'EC reply timed out. Check power and firmware; the operation may have completed.'
+                        )
+                    );
+                },
+                payload[0] === 2 && payload.length >= 14 && payload[4] === 3 ? 50000 : 20000
